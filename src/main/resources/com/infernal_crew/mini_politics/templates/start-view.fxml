                    </graphic>
                </Label>
                <Label styleClass="filmWindow"  alignment="CENTER">
                    <graphic>
                        <ImageView fitHeight="128.0" fitWidth="128.0" pickOnBounds="true" preserveRatio="true">
                            <Image url="@../menu_icons/people/Mike Hill.jpg"/>
                        </ImageView>
                    </graphic>
                </Label>
                <Label styleClass="filmWindow"  alignment="CENTER">
                    <graphic>
                        <ImageView fitHeight="128.0" fitWidth="128.0" pickOnBounds="true" preserveRatio="true">
                            <Image url="@../menu_icons/people/Winston Oldwood.jpg"/>
                        </ImageView>
                    </graphic>
                </Label>
                <Label styleClass="filmWindow"  alignment="CENTER">
                    <graphic>
