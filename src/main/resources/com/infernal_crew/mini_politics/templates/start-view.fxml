<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="400.0" prefWidth="600.0"  xmlns="http://javafx.com/javafx/16"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.infernal_crew.mini_politics.controllers.StartView">
    <left>
        <VBox fx:id="leftFilmRoll" styleClass="filmRollOuter">
            <VBox styleClass="filmRoll">
                <Label styleClass="filmWindow"  alignment="CENTER">
                    <graphic>
                        <ImageView fitHeight="128.0" fitWidth="128.0" pickOnBounds="true" preserveRatio="true">
                            <Image url="@../menu_icons/people/Andreas Argentos.jpg"/>
                        </ImageView>
                    </graphic>
                </Label>
                <Label styleClass="filmWindow" alignment="CENTER">
                    <graphic>
                        <ImageView fitHeight="128.0" fitWidth="128.0" pickOnBounds="true" preserveRatio="true">
