<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="458.0" prefWidth="705.0" xmlns="http://javafx.com/javafx/16" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.infernal_crew.mini_politics.controllers.BudgetController">
    <VBox alignment="TOP_RIGHT" prefHeight="458.0" prefWidth="747.0">
        <TextField alignment="CENTER" editable="false" prefHeight="58.0" prefWidth="765.0" style="-fx-font-size: 28;" text="BUDGET" />
        <HBox prefHeight="50.0" prefWidth="354.0" style="-fx-background-color: #EEEEEE;">
            <RadioButton fx:id="incomeButton" mnemonicParsing="false" onAction="#onIncomeButtonClick" prefHeight="38.0" prefWidth="365.0" text="Income">
                <toggleGroup>
                    <ToggleGroup fx:id="incomeOrExpenses" />
                </toggleGroup>
            </RadioButton>
            <RadioButton fx:id="expensesButton" mnemonicParsing="false" onAction="#onExpenseButtonClick" prefHeight="38.0" prefWidth="383.0" selected="true" text="Expenses">
                <toggleGroup>
                    <fx:reference source="incomeOrExpenses" />
                </toggleGroup>
            </RadioButton>
        </HBox>
        <HBox styleClass="viewContent">
            <PieChart fx:id="chart" animated="false" clockwise="false" labelsVisible="false" legendSide="RIGHT" prefHeight="354.0" prefWidth="786.0" />
        </HBox>
    </VBox>
   <effect>
      <DropShadow />
   </effect>
</AnchorPane>
