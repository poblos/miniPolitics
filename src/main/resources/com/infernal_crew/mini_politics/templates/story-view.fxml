<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.TextFlow?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/16" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.infernal_crew.mini_politics.controllers.StoryController">
    <stylesheets>
        <URL value="@../styles/left_bar.css" />
    </stylesheets>

    <VBox>
        <Label alignment="CENTER" prefHeight="55.0" prefWidth="600.0" style="-fx-font-size: 28;" styleClass="titleBar" text="STORY" />
        <HBox prefWidth="600.0" >
            <VBox fx:id="storyBox" styleClass="viewContent" prefWidth="100.0"/>
            <VBox styleClass="viewContent" prefWidth="300.0">
                <TextFlow fx:id="title" prefWidth="600.0"/>
                <TextFlow fx:id="description" prefWidth="600.0"/>
            </VBox>
        </HBox>

        <Label alignment="CENTER" prefHeight="37.0" prefWidth="599.0" styleClass="bottomBar" />
    </VBox>
    <effect>
        <DropShadow />
    </effect>
</AnchorPane>
